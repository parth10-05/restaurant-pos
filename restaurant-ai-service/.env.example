# Restaurant AI Microservice Environment Variables
# Copy this file to .env and update values

# ===========================================
# Application Settings
# ===========================================
ENVIRONMENT=development  # development | staging | production
HOST=0.0.0.0
PORT=8000

# ===========================================
# CORS Configuration
# ===========================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ===========================================
# ML Model Settings
# ===========================================
# Random seed for reproducibility
RANDOM_SEED=42

# Default forecast horizon (days)
FORECAST_HORIZON_DAYS=30

# Confidence level for predictions (0-1)
CONFIDENCE_LEVEL=0.95

# Model preference: prophet | arima | auto
DEFAULT_MODEL=auto

# ===========================================
# Cache Settings
# ===========================================
# Enable/disable caching
CACHE_ENABLED=true

# Cache TTL in seconds (default: 1 hour)
CACHE_TTL_SECONDS=3600

# Maximum cache entries
CACHE_MAX_SIZE=1000

# ===========================================
# Docker Settings
# ===========================================
# Port for production AI service
AI_SERVICE_PORT=8000

# Port for development AI service (with hot reload)
AI_SERVICE_DEV_PORT=8001

# ===========================================
# Logging
# ===========================================
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ===========================================
# Optional: External Services
# ===========================================
# If connecting to external model serving
# MODEL_SERVER_URL=http://localhost:8501
# MODEL_SERVER_TIMEOUT=30

# If using Redis for distributed caching
# REDIS_URL=redis://localhost:6379/0

# If using database for model persistence
# DATABASE_URL=postgresql://user:pass@localhost:5432/ai_models
