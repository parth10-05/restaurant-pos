generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KitchenStation {
  GRILL
  FRYER
  DRINKS
  DESSERT
  GENERAL
}

enum StockChangeSource {
  ORDER_CONSUMPTION
  WASTE
  MANUAL_ADJUSTMENT
  PURCHASE
}

enum WasteReason {
  SPOILAGE
  OVERCOOKED
  RETURNED
  PREP_LOSS
}

model User {
  id          String        @id @default(uuid())
  email       String        @unique
  password    String
  role        String        @default("cashier")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  orders      Order[]
  posSessions POS_Session[]
  aiJobs      AIJob[]
  ledgerEntries InventoryLedger[]
  wasteEvents   WasteEvent[]
}

model ProductCategory {
  id       String    @id @default(uuid())
  name     String    @unique
  sequence Int
  active   Boolean   @default(true)
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  demandForecasts ProductDemandForecast[]
}

model Product {
  id             String   @id @default(uuid())
  name           String
  description    String?
  price          Float
  taxPercent     Float
  isActive       Boolean  @default(true)
  sendToKitchen  Boolean  @default(true)
  kitchenStation KitchenStation @default(GENERAL)
  categoryId     String
  category       ProductCategory @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  demandForecasts    ProductDemandForecast[]
  productIngredients ProductIngredient[]
}

model Floor {
  id       String  @id @default(uuid())
  name     String
  sequence Int
  active   Boolean @default(true)
  tables   Table[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Table {
  id      String  @id @default(uuid())
  number  Int
  seats   Int
  active  Boolean @default(true)
  floorId String
  floor   Floor   @relation(fields: [floorId], references: [id])
  orders  Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([floorId, number])
}

model POS_Session {
  id           String    @id @default(uuid())
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  status       String    @default("open")
  openedBy     String
  closingTotal Float?
  user         User      @relation(fields: [openedBy], references: [id])
  orders       Order[]
  wasteEvents  WasteEvent[]
}

model Order {
  id            String         @id @default(uuid())
  sessionId     String
  userId        String
  tableId       String
  status        String         @default("draft")
  total         Float          @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  session       POS_Session    @relation(fields: [sessionId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  table         Table          @relation(fields: [tableId], references: [id])
  orderLines    OrderLine[]
  payment       Payment?
  kitchenTicket KitchenTicket?
  ledgerEntries InventoryLedger[]
}

model OrderLine {
  id                Int       @id @default(autoincrement())
  orderId           String
  productId         String
  name              String
  price             Float
  qty               Int
  taxAmount         Float     @default(0)
  kitchenStation    KitchenStation @default(GENERAL)
  sentToKitchen     Boolean   @default(false)
  kitchenStatus     String?   // PENDING | PREPARING | READY
  sentToKitchenAt   DateTime?
  preparedAt        DateTime?
  createdAt         DateTime  @default(now())
  order             Order     @relation(fields: [orderId], references: [id])
}

model Payment {
  id        Int      @id @default(autoincrement())
  orderId   String   @unique
  amount    Float
  method    String
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])
}

model KitchenTicket {
  id        String   @id @default(uuid())
  orderId   String   @unique
  status    String   @default("to_cook")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id])
}

model PosConfig {
  id                    String   @id @default(uuid())
  posName               String   @default("Adani POS")
  defaultTax            Float    @default(5.0)
  enableKitchenDisplay  Boolean  @default(true)
  enableCustomerDisplay Boolean  @default(false)
  enableCash            Boolean  @default(true)
  enableDigital         Boolean  @default(true)
  enableUpi             Boolean  @default(false)
  upiId                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model ReceiptSettings {
  id                String   @id @default(uuid())
  restaurantName    String   @default("Adani Restaurant")
  address           String   @default("")
  phone             String?
  gstNumber         String?
  logoUrl           String?
  showOrderNumber   Boolean  @default(true)
  showCashier       Boolean  @default(true)
  showPaymentMethod Boolean  @default(true)
  showItemTax       Boolean  @default(true)
  showTotalTax      Boolean  @default(true)
  showQrCode        Boolean  @default(false)
  paperWidth        String   @default("80mm")
  fontScale         String   @default("normal")
  footerText        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SalesForecast {
  id             String   @id @default(uuid())
  granularity    String   // "daily" | "hourly"
  targetDate     DateTime
  hour           Int?     // 0-23 for hourly, null for daily
  forecastValue  Float    // predicted revenue
  forecastOrders Int?     // predicted order count
  lowerBound     Float?
  upperBound     Float?
  baseline       Float?   // historical mean
  method         String   // "sma_7", "ewma_0.3", etc.
  generatedAt    DateTime @default(now())

  @@index([granularity, targetDate])
}

model ProductDemandForecast {
  id          String   @id @default(uuid())
  productId   String
  categoryId  String?
  granularity String   // "daily"
  targetDate  DateTime
  forecastQty Float
  baselineQty Float?
  lowerBound  Float?
  upperBound  Float?
  method      String
  generatedAt DateTime @default(now())

  product  Product          @relation(fields: [productId], references: [id])
  category ProductCategory? @relation(fields: [categoryId], references: [id])

  @@index([productId, targetDate])
  @@index([categoryId, targetDate])
}

model SalesAnomaly {
  id            String   @id @default(uuid())
  scope         String   // "sales_daily" | "sales_hourly" | "product"
  targetId      String?  // productId when scope=product
  windowStart   DateTime
  windowEnd     DateTime
  hour          Int?
  metric        String   // "revenue" | "orders" | "qty"
  observedValue Float
  expectedValue Float
  zScore        Float
  deviationPct  Float
  direction     String   // "spike" | "drop"
  method        String   // "zscore_v1"
  detectedAt    DateTime @default(now())

  @@index([scope, windowStart])
}

model AIJob {
  id          String    @id @default(uuid())
  type        String    // "sales_forecast" | "demand_forecast" | "anomaly_detection"
  status      String    @default("pending")
  params      String?   // JSON stringified params
  result      String?   // JSON stringified result summary
  error       String?
  triggeredBy String?
  user        User?     @relation(fields: [triggeredBy], references: [id])
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([type, status])
  @@index([startedAt])
}

// ─── INVENTORY MODULE MODELS ─────────────────────────────────────────

model Ingredient {
  id          String   @id @default(uuid())
  name        String   @unique
  unit        String   // "kg", "g", "l", "ml", "pcs", etc.
  costPerUnit Float    @default(0)
  minStock    Float    @default(0) // alert threshold
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productIngredients ProductIngredient[]
  stock              InventoryStock?
  ledgerEntries      InventoryLedger[]
  wasteEvents        WasteEvent[]
}

model ProductIngredient {
  id           String @id @default(uuid())
  productId    String
  ingredientId String
  quantity     Float  // quantity of ingredient per 1 unit of product

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, ingredientId])
  @@index([productId])
  @@index([ingredientId])
}

model InventoryStock {
  id           String   @id @default(uuid())
  ingredientId String   @unique
  quantity     Float    @default(0)
  lastUpdated  DateTime @default(now())

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId])
}

model InventoryLedger {
  id           String            @id @default(uuid())
  ingredientId String
  changeQty    Float             // positive for additions, negative for deductions
  balanceAfter Float
  source       StockChangeSource
  referenceId  String?           // orderId, purchaseId, etc.
  notes        String?
  createdBy    String?
  createdAt    DateTime          @default(now())

  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  user       User?      @relation(fields: [createdBy], references: [id])
  order      Order?     @relation(fields: [referenceId], references: [id])

  @@index([ingredientId, createdAt])
  @@index([source])
  @@index([referenceId])
}

// ─── WASTE TRACKING MODULE ───────────────────────────────────────────

model WasteEvent {
  id           String         @id @default(uuid())
  ingredientId String
  quantity     Float          // always positive; represents amount wasted
  reason       WasteReason
  station      KitchenStation @default(GENERAL)
  sessionId    String?        // link to active POS session if available
  notes        String?
  createdBy    String?
  createdAt    DateTime       @default(now())

  ingredient Ingredient   @relation(fields: [ingredientId], references: [id])
  session    POS_Session? @relation(fields: [sessionId], references: [id])
  user       User?        @relation(fields: [createdBy], references: [id])

  @@index([ingredientId, createdAt])
  @@index([reason])
  @@index([station])
  @@index([sessionId])
}